[Unit]
Description=InterLink Autolauncher Plugin
After=network.target

[Service]
Type=simple
User=root
Environment=AUTOLAUNCHER_PLUGIN_CONFIG=/etc/autolauncher-plugin/config.yaml
WorkingDirectory=/opt/interlink-autolauncher-plugin
ExecStart=/opt/interlink-autolauncher-plugin/.venv/bin/python -m plugin.run
Restart=on-failure
RestartSec=2s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
