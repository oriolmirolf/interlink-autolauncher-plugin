plugin:
  # UDS-first. When running as user 'ubuntu', this becomes /home/ubuntu/.interlink/.plugin.sock
  uds: "~/.interlink/.plugin.sock"

  # If you want TCP instead of a unix socket, comment 'uds' out and set:
  # bind_host: "127.0.0.1"
  # bind_port: 8001

hpc:
  # Placeholder section for your AMD-CTE settings (if needed by the provider)
  # login_host: "amdlogin1.bsc.es"
  # ssh_user: ""
  # autolauncher_path: "~/.autolauncher/autolauncher.py"
